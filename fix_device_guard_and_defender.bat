@echo off
title Mass-Code - Fix Device Guard & Smart App Control
echo ===================================================================
echo  Mass-Code - Windows Defender, Device Guard & Smart App Control Fix
echo ===================================================================
echo.
echo Requesting Administrator privileges to disable Smart App Control (SAC)
echo and add Windows Defender exclusions for GCC compilers and workspaces...
echo.

powershell -Command "Start-Process powershell -Verb RunAs -ArgumentList '-NoProfile -ExecutionPolicy Bypass -Command \"Write-Host ''[1/3] Disabling Smart App Control / Device Guard (VerifiedAndReputablePolicyState=0)...'' -ForegroundColor Yellow; $policyPath = ''HKLM:\SYSTEM\CurrentControlSet\Control\CI\Policy''; if (-not (Test-Path $policyPath)) { New-Item -Path $policyPath -Force | Out-Null }; Set-ItemProperty -Path $policyPath -Name ''VerifiedAndReputablePolicyState'' -Value 0 -Type DWord -Force; if (Get-Command CiTool.exe -ErrorAction SilentlyContinue) { Write-Host ''[2/3] Refreshing Code Integrity policies with CiTool...'' -ForegroundColor Yellow; CiTool.exe -r }; Write-Host ''[3/3] Adding Windows Defender folder and process exclusions...'' -ForegroundColor Yellow; Add-MpPreference -ExclusionPath ''%~dp0'' -ErrorAction SilentlyContinue; Add-MpPreference -ExclusionPath ''%APPDATA%\Mass-Code'' -ErrorAction SilentlyContinue; Add-MpPreference -ExclusionPath ''%TEMP%\mass-code-temp'' -ErrorAction SilentlyContinue; Add-MpPreference -ExclusionPath ''%~dp0temp'' -ErrorAction SilentlyContinue; Add-MpPreference -ExclusionProcess ''Mass-Code.exe'' -ErrorAction SilentlyContinue; Add-MpPreference -ExclusionProcess ''runner.exe'' -ErrorAction SilentlyContinue; Add-MpPreference -ExclusionProcess ''solution.exe'' -ErrorAction SilentlyContinue; Add-MpPreference -ExclusionProcess ''a.exe'' -ErrorAction SilentlyContinue; Add-MpPreference -ExclusionProcess ''gcc.exe'' -ErrorAction SilentlyContinue; Write-Host ''''; Write-Host ''======================================================'' -ForegroundColor Green; Write-Host '' [SUCCESS] Device Guard & Smart App Control Disabled!'' -ForegroundColor Green; Write-Host '' Windows Defender exclusions applied successfully.'' -ForegroundColor Green; Write-Host ''======================================================'' -ForegroundColor Green; Write-Host ''You can now compile and run any C/C++ program in Mass-Code without exit code 4551.'' -ForegroundColor Cyan; Write-Host ''''; Write-Host ''Note: If Windows requires a reboot for Smart App Control to fully release, please restart your computer.'' -ForegroundColor Gray; Start-Sleep -Seconds 6\"'"

